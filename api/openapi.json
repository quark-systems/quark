{
  "openapi": "3.1.0",
  "info": {
    "title": "Quark daemon API",
    "description": "Local control plane API served by quarkd on localhost.",
    "license": {
      "name": "MIT"
    },
    "version": "0.0.1"
  },
  "paths": {
    "/v1/decisions": {
      "get": {
        "tags": [
          "decisions"
        ],
        "summary": "The decisions inbox across all Projects.",
        "operationId": "list_decisions",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "description": "Only decisions in this state.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/DecisionState"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Decision"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Typed event stream (WebSocket).",
        "description": "Each text frame is one JSON `Event`. Upgrade with a standard WebSocket\nhandshake; the server ignores client frames other than close.",
        "operationId": "stream",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "description": "Last `seq` the client has seen. Every later event is replayed before\nlive events. Omit to receive only events after connecting; pass 0 to\nreplay the whole log.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "Switching to WebSocket; each frame is an Event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "tags": [
          "daemon"
        ],
        "summary": "Daemon health and the latest event `seq`.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "List Projects.",
        "operationId": "list_projects",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "projects"
        ],
        "summary": "Create a Project.",
        "description": "Phase 0 records the Project in the daemon only. Seeding its engine\nworkspace arrives with the adapter write path.",
        "operationId": "create_project",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProject"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{id}": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "Get one Project.",
        "operationId": "get_project",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Project id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "projects"
        ],
        "summary": "Configure a Project. Absent fields are left unchanged.",
        "operationId": "update_project",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Project id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProject"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{id}/tasks": {
      "get": {
        "tags": [
          "tasks"
        ],
        "summary": "The task board for one Project.",
        "operationId": "list_tasks",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Project id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{id}/terminals": {
      "get": {
        "tags": [
          "terminals"
        ],
        "summary": "Live terminals of one Project: its coordinator and its workers.",
        "operationId": "list_terminals",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Project id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Terminal"
                  }
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tasks/{id}": {
      "get": {
        "tags": [
          "tasks"
        ],
        "summary": "Task detail.",
        "operationId": "get_task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Task id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/terminals/{id}": {
      "get": {
        "tags": [
          "terminals"
        ],
        "summary": "One terminal. Its id is the task id for a worker and the Project id for\na coordinator.",
        "operationId": "get_terminal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Terminal id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Terminal"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/terminals/{id}/input": {
      "post": {
        "tags": [
          "terminals"
        ],
        "summary": "Type raw bytes into a terminal.",
        "description": "Requests for one terminal are applied in the order they arrive, and HTTP\nrequests can overtake each other, so keep one request in flight per\nterminal and coalesce keys typed meanwhile, or send `seq`.",
        "operationId": "input",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Terminal id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TerminalInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Typed"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`seq` is not after the last applied one",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/terminals/{id}/resize": {
      "post": {
        "tags": [
          "terminals"
        ],
        "summary": "Resize a terminal. The last size set wins for every viewer.",
        "operationId": "resize",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Terminal id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TerminalResize"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Terminal"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/terminals/{id}/snapshot": {
      "post": {
        "tags": [
          "terminals"
        ],
        "summary": "Snapshot a terminal's screen.",
        "description": "Appends a `worker.output` snapshot event and returns it. To open a\nterminal, subscribe to the event stream, call this, apply the returned\nsnapshot, then apply the terminal's events with a greater `seq`.",
        "operationId": "snapshot",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Terminal id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateProject": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "goal": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "workspace_path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Decision": {
        "type": "object",
        "description": "A question held for a person.",
        "required": [
          "id",
          "project_id",
          "question",
          "state",
          "opened_at"
        ],
        "properties": {
          "answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "answered_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "answered_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "opened_at": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/DecisionState"
          },
          "task_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DecisionState": {
        "type": "string",
        "enum": [
          "open",
          "answered"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code, e.g. `not_found`."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Event": {
        "type": "object",
        "description": "One entry of the event stream. `seq` is monotonic across the whole daemon;\na client that reconnects with `/v1/events?cursor=<last seq>` receives every\nevent with a greater `seq`, replayed from the store, then live events.",
        "required": [
          "seq",
          "type",
          "ts",
          "payload"
        ],
        "properties": {
          "payload": {
            "type": "object"
          },
          "project_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Absent for daemon-wide events."
          },
          "seq": {
            "type": "integer",
            "format": "int64"
          },
          "ts": {
            "type": "string",
            "description": "RFC 3339 UTC timestamp."
          },
          "type": {
            "$ref": "#/components/schemas/EventType"
          }
        }
      },
      "EventType": {
        "type": "string",
        "description": "Every event type the stream can carry. Phase 0 emits the project, task and\ndecision events; the rest are reserved so clients can be generated now.",
        "enum": [
          "project.updated",
          "task.created",
          "task.state_changed",
          "coordinator.message",
          "worker.transcript",
          "worker.output",
          "decision.opened",
          "decision.answered",
          "pr.updated",
          "check.updated",
          "review.updated",
          "dispatch.recorded",
          "account.quota_changed"
        ]
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version",
          "engine",
          "last_seq"
        ],
        "properties": {
          "engine": {
            "type": "string",
            "description": "Name of the engine adapter in use."
          },
          "last_seq": {
            "type": "integer",
            "format": "int64",
            "description": "Highest event `seq` in the store; 0 when empty."
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Project": {
        "type": "object",
        "description": "A Project: a goal-driven workspace that owns tasks, decisions and PRs.",
        "required": [
          "id",
          "name",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "goal": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "workspace_path": {
            "type": [
              "string",
              "null"
            ],
            "description": "Local path of the Project workspace, when one is attached."
          }
        }
      },
      "Task": {
        "type": "object",
        "required": [
          "id",
          "project_id",
          "title",
          "state",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "harness": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TaskKind"
              },
              {
                "type": "null"
              }
            ]
          },
          "project_id": {
            "type": "string"
          },
          "pull_request_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "$ref": "#/components/schemas/TaskState"
          },
          "state_note": {
            "type": [
              "string",
              "null"
            ],
            "description": "Short human-readable note about the latest state change."
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "TaskKind": {
        "type": "string",
        "description": "What a task delivers.",
        "enum": [
          "ship",
          "scout"
        ]
      },
      "TaskState": {
        "type": "string",
        "description": "Neutral task lifecycle state. Engine adapters map their own states onto\nthese; anything they cannot classify is `unknown`.",
        "enum": [
          "queued",
          "running",
          "needs_decision",
          "blocked",
          "paused",
          "in_review",
          "done",
          "failed",
          "unknown"
        ]
      },
      "Terminal": {
        "type": "object",
        "description": "A live terminal: one session pane the daemon streams as `worker.output`.",
        "required": [
          "id",
          "project_id",
          "role",
          "title",
          "cols",
          "rows"
        ],
        "properties": {
          "cols": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "id": {
            "type": "string",
            "description": "The task id for a worker, the Project id for a coordinator."
          },
          "project_id": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/TerminalRole"
          },
          "rows": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "task_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Set for worker terminals."
          },
          "title": {
            "type": "string"
          }
        }
      },
      "TerminalChunkKind": {
        "type": "string",
        "description": "What a `worker.output` event carries.",
        "enum": [
          "output",
          "snapshot"
        ]
      },
      "TerminalInput": {
        "type": "object",
        "description": "Raw bytes to type into a terminal.",
        "required": [
          "data_b64"
        ],
        "properties": {
          "data_b64": {
            "type": "string",
            "description": "Base64 of the bytes, exactly as a terminal would send them\n(`\\r` for Enter, escape sequences for keys)."
          },
          "seq": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Optional per-terminal sequence number. When given, it must be greater\nthan the last one applied, so a retried request is not typed twice.",
            "minimum": 0
          }
        }
      },
      "TerminalOutput": {
        "type": "object",
        "description": "Payload of a `worker.output` event.",
        "required": [
          "terminal_id",
          "role",
          "kind",
          "data_b64"
        ],
        "properties": {
          "cols": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Terminal size; set on snapshots.",
            "minimum": 0
          },
          "data_b64": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/TerminalChunkKind"
          },
          "role": {
            "$ref": "#/components/schemas/TerminalRole"
          },
          "rows": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "task_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "terminal_id": {
            "type": "string"
          }
        }
      },
      "TerminalResize": {
        "type": "object",
        "required": [
          "cols",
          "rows"
        ],
        "properties": {
          "cols": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "rows": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "TerminalRole": {
        "type": "string",
        "description": "Who a terminal belongs to.",
        "enum": [
          "coordinator",
          "worker"
        ]
      },
      "UpdateProject": {
        "type": "object",
        "description": "Partial update; absent fields are left unchanged.",
        "properties": {
          "goal": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "workspace_path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "daemon"
    },
    {
      "name": "projects"
    },
    {
      "name": "tasks"
    },
    {
      "name": "decisions"
    },
    {
      "name": "terminals"
    },
    {
      "name": "events"
    }
  ]
}
