#!/usr/bin/env bash
# quark-verify: launch, doctor, drive and clean up an isolated Quark instance
# for verification. See ../SKILL.md for the full recipe.
#
#   quark-verify launch [--daemon real|mock] [--engine stub|firstmate] [--engine-dir DIR] [--harness real|fake] [--run ID]
#   quark-verify doctor
#   quark-verify env                         print the run's variables (eval-able)
#   quark-verify browser <command> ...       drive the app (bin/browser.mjs)
#   quark-verify api <METHOD> <path> [json]  call the daemon's /v1 API; prints the body, fails on HTTP >= 400
#   quark-verify events [--since SEQ] [--for SECS]   print event-stream frames as JSON lines
#   quark-verify tmux <args...>              tmux against the run's private server (real daemon only)
#   quark-verify capture <name> -- <cmd...>  run a command, saving cmd, stdout, stderr and exit code as evidence
#   quark-verify crash daemon|tmux|host      kill the daemon, the tmux server, or every process the run started (a reboot)
#   quark-verify restart                     start the daemon again on its home and port, as a login would
#   quark-verify sleep <secs>                stop every process the run started for <secs>, then continue them
#   quark-verify agents                      the fake harness's start journal, one JSON line per agent start
#   quark-verify journey <name> [args]       run a scripted journey in runs of its own (bin/journey-<name>)
#   quark-verify cleanup                     stop everything the run started; evidence stays
#
# A run lives in $QUARK_VERIFY_HOME/<run-id> (default ~/.cache/quark-verify):
# instance/ holds the daemon home, logs and pids and is removed by cleanup;
# evidence/ holds proof artifacts and is never removed by this script.
# Commands act on $QUARK_VERIFY_RUN, else the run named in $QUARK_VERIFY_HOME/current.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo=$(cd "$here/../../../.." && pwd)
base=${QUARK_VERIFY_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/quark-verify}

die() { echo "quark-verify: $*" >&2; exit 1; }

free_port() {
  local p
  for _ in $(seq 1 50); do
    p=$((20000 + RANDOM % 30000))
    if ! (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null; then echo "$p"; return; fi
  done
  die "no free port found"
}

wait_http() { # url secs what
  local i
  for i in $(seq 1 $(($2 * 5))); do
    curl -sf -o /dev/null "$1" && return 0
    sleep 0.2
  done
  die "$3 did not answer on $1 within $2s"
}

load() {
  local id=${QUARK_VERIFY_RUN:-}
  [ -n "$id" ] || id=$(cat "$base/current" 2>/dev/null) || die "no run; start one with: quark-verify launch"
  run_dir=$base/$id
  [ -f "$run_dir/instance/run.env" ] || die "run $id has no instance (cleaned up?); evidence is in $run_dir/evidence"
  # shellcheck disable=SC1091
  . "$run_dir/instance/run.env"
}

chromium_bin() {
  if [ -n "${PW_CHROMIUM:-}" ]; then echo "$PW_CHROMIUM"; return; fi
  if [ -x /opt/pw-browsers/chromium ]; then echo /opt/pw-browsers/chromium; return; fi
  (cd "$repo/app" && node -e 'console.log(require("@playwright/test").chromium.executablePath())')
}

start_bg() { # name cmd... ; records instance/<name>.pid, appends to instance/<name>.log
  local name=$1; shift
  setsid "$@" >>"$inst/$name.log" 2>&1 < /dev/null &
  echo $! >"$inst/$name.pid"
}

cmd_launch() {
  local daemon=real engine=stub engine_dir="" harness=real id=""
  while [ $# -gt 0 ]; do
    case $1 in
      --daemon) daemon=$2; shift 2 ;;
      --engine) engine=$2; shift 2 ;;
      --engine-dir) engine_dir=$2; shift 2 ;;
      --harness) harness=$2; shift 2 ;;
      --run) id=$2; shift 2 ;;
      *) die "launch: unknown argument $1" ;;
    esac
  done
  case $daemon in real|mock) ;; *) die "--daemon must be real or mock" ;; esac
  case $engine in stub|firstmate) ;; *) die "--engine must be stub or firstmate" ;; esac
  case $harness in real|fake) ;; *) die "--harness must be real or fake" ;; esac
  [ "$engine" = firstmate ] && [ -z "$engine_dir" ] && die "--engine firstmate needs --engine-dir <quark-systems/firstmate checkout>"
  id=${id:-$(date -u +%Y%m%dT%H%M%SZ)-$$}
  run_dir=$base/$id
  inst=$run_dir/instance
  [ -e "$inst" ] && die "run $id already has an instance; clean it up or pick another --run"
  mkdir -p "$inst" "$run_dir/evidence"

  echo "building the app (app/dist)..." >&2
  [ -d "$repo/app/node_modules" ] || (cd "$repo/app" && npm ci --no-audit --no-fund >&2)
  (cd "$repo/app" && npm run --silent build >"$inst/app-build.log" 2>&1) || die "app build failed; see $inst/app-build.log"

  local dport aport cport home="" daemon_url sock=""
  dport=$(free_port); aport=$(free_port); cport=$(free_port)
  daemon_url=http://127.0.0.1:$dport
  if [ "$daemon" = real ]; then
    echo "building quarkd..." >&2
    (cd "$repo" && cargo build --quiet -p quarkd 2>"$inst/cargo.log") || die "quarkd build failed; see $inst/cargo.log"
    local target=${CARGO_TARGET_DIR:-$repo/target}
    home=$inst/home
    # quarkd's tmux server listens on <home>/run/tmux/quark; a unix socket path
    # over ~104 bytes cannot be bound, and terminals would silently be off.
    [ ${#home} -le 80 ] || die "daemon home $home is too long for a tmux socket; set QUARK_VERIFY_HOME to a shorter directory"
    mkdir -p "$home"
    if [ "$engine" = firstmate ]; then
      git clone --quiet "$engine_dir" "$home/engine" || die "cloning the engine from $engine_dir failed"
    fi
    # The daemon starts from a script so `restart` can start it again exactly
    # as launched. With --harness fake, agents the engine opens run
    # bin/fake-agent in place of the harness CLIs, and the tmux server (started
    # by the daemon) inherits that PATH, a profile-free shell and the journal.
    {
      echo '#!/usr/bin/env bash'
      if [ "$harness" = fake ]; then
        mkdir -p "$inst/fakebin"
        local h
        for h in claude codex; do ln -s "$here/fake-agent" "$inst/fakebin/$h"; done
        # A login shell's profile can put the real CLIs back in front of
        # fakebin, so the tmux server's windows get a shell without profile.
        # shellcheck disable=SC2016 # $PATH and $@ expand when the shell runs
        printf '#!/usr/bin/env bash\nexport PATH=%q:"$PATH"\nexec bash --noprofile --norc "$@"\n' \
          "$inst/fakebin" >"$inst/fakebin/shell"
        chmod +x "$inst/fakebin/shell"
        # shellcheck disable=SC2016
        printf 'export PATH=%q:"$PATH"\n' "$inst/fakebin"
        printf 'export SHELL=%q\n' "$inst/fakebin/shell"
        printf 'export QV_AGENT_JOURNAL=%q\n' "$run_dir/evidence/agents.jsonl"
      fi
      printf 'exec %q --home %q --listen %q --engine %q\n' "$target/debug/quarkd" "$home" "127.0.0.1:$dport" "$engine"
    } >"$inst/quarkd.sh"
    chmod +x "$inst/quarkd.sh"
    start_bg quarkd "$inst/quarkd.sh"
    sock=$home/run/tmux/quark
  else
    engine=mock
    start_bg quarkd node "$repo/app/mock/daemon.mjs" --port "$dport" --quiet
  fi
  start_bg serve node "$here/serve.mjs" --port "$aport" --daemon "$daemon_url" --dist "$repo/app/dist"
  start_bg chromium "$(chromium_bin)" --headless=new --no-sandbox --disable-gpu --no-first-run \
    --remote-debugging-address=127.0.0.1 --remote-debugging-port="$cport" \
    --user-data-dir="$inst/chromium-profile" --window-size=1400,900 about:blank

  cat >"$inst/run.env" <<EOF
QV_RUN=$id
QV_MODE=$daemon
QV_ENGINE=$engine
QV_HARNESS=$harness
QV_DAEMON=$daemon_url
QV_APP=http://127.0.0.1:$aport/
QV_DAEMON_FOR_APP=http://127.0.0.1:$aport
QV_CDP=http://127.0.0.1:$cport
QV_HOME=$home
QV_TMUX_SOCKET=$sock
QV_EVIDENCE=$run_dir/evidence
QV_COMMIT=$(git -C "$repo" rev-parse --short HEAD)
EOF
  echo "$id" >"$base/current"
  wait_http "$daemon_url/v1/health" 60 "the daemon"
  wait_http "http://127.0.0.1:$aport/" 20 "the app server"
  wait_http "http://127.0.0.1:$cport/json/version" 20 "chromium"
  echo "launched run $id" >&2
  cat "$inst/run.env"
}

alive() { [ -f "$inst/$1.pid" ] && kill -0 "$(cat "$inst/$1.pid")" 2>/dev/null; }

cmd_doctor() {
  load
  inst=$run_dir/instance
  local ok=1 n h
  for n in quarkd serve chromium; do
    if alive "$n"; then echo "ok   $n pid $(cat "$inst/$n.pid")"; else echo "FAIL $n is not running (log: $inst/$n.log)"; ok=0; fi
  done
  if h=$(curl -sf "$QV_DAEMON/v1/health"); then
    echo "ok   daemon $QV_DAEMON: $h"
    if [ "$QV_MODE" = real ]; then
      echo "$h" | grep -q "\"engine\":\"$QV_ENGINE\"" || { echo "FAIL daemon reports a different engine than $QV_ENGINE"; ok=0; }
    fi
  else echo "FAIL daemon does not answer on $QV_DAEMON"; ok=0; fi
  if curl -sf "${QV_APP}v1/health" >/dev/null; then echo "ok   app $QV_APP proxies /v1 to the daemon"; else echo "FAIL app server $QV_APP does not proxy /v1"; ok=0; fi
  if curl -sf "$QV_CDP/json/version" >/dev/null; then echo "ok   chromium CDP $QV_CDP"; else echo "FAIL chromium CDP does not answer"; ok=0; fi
  if [ "$QV_MODE" = real ]; then
    if tmux -S "$QV_TMUX_SOCKET" list-sessions >/dev/null 2>&1; then echo "ok   private tmux server $QV_TMUX_SOCKET"
    else echo "note private tmux server not started yet (quarkd starts it on the first terminal or engine call)"; fi
  fi
  echo "build $QV_COMMIT, mode $QV_MODE, engine $QV_ENGINE, evidence $QV_EVIDENCE"
  [ "$ok" = 1 ] || exit 1
}

cmd_api() {
  load
  [ $# -ge 2 ] || die "api: usage: api <METHOD> <path> [json]"
  local method=$1 p=$2 body=${3:-} out code
  out=$(mktemp)
  if [ -n "$body" ]; then
    code=$(curl -s -o "$out" -w '%{http_code}' -X "$method" -H 'content-type: application/json' -d "$body" "$QV_DAEMON$p")
  else
    code=$(curl -s -o "$out" -w '%{http_code}' -X "$method" "$QV_DAEMON$p")
  fi
  cat "$out"; echo; rm -f "$out"
  [ "$code" -lt 400 ] || die "api: $method $p answered HTTP $code"
}

cmd_events() {
  load
  local since=0 secs=2
  while [ $# -gt 0 ]; do
    case $1 in --since) since=$2; shift 2 ;; --for) secs=$2; shift 2 ;; *) die "events: unknown argument $1" ;; esac
  done
  (cd "$repo/app" && node -e '
    const WebSocket = require("ws");
    const ws = new WebSocket(process.argv[1]);
    ws.on("message", (m) => console.log(m.toString()));
    ws.on("error", (e) => { console.error(e.message); process.exit(1); });
    setTimeout(() => { ws.close(); process.exit(0); }, Number(process.argv[2]) * 1000);
  ' "${QV_DAEMON/http/ws}/v1/events?cursor=$since" "$secs")
}

cmd_tmux() {
  load
  [ -n "$QV_TMUX_SOCKET" ] || die "tmux: the mock daemon has no tmux server"
  tmux -S "$QV_TMUX_SOCKET" "$@"
}

cmd_capture() {
  load
  local name=${1:-}; shift || true
  [ -n "$name" ] && [ "${1:-}" = "--" ] || die "capture: usage: capture <name> -- <cmd...>"
  shift
  local dir=$QV_EVIDENCE/$name code=0
  mkdir -p "$dir"
  printf '%q ' "$@" >"$dir/cmd.txt"; echo >>"$dir/cmd.txt"
  "$@" >"$dir/stdout.txt" 2>"$dir/stderr.txt" || code=$?
  echo "$code" >"$dir/exit-code.txt"
  cat "$dir/stdout.txt"
  [ -s "$dir/stderr.txt" ] && cat "$dir/stderr.txt" >&2
  echo "captured $name (exit $code) in $dir" >&2
  return "$code"
}

stop_pid() { # name
  local f=$inst/$1.pid pid
  [ -f "$f" ] || return 0
  pid=$(cat "$f")
  # Each process was started with setsid, so its pid is its process group.
  kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  for _ in $(seq 1 25); do kill -0 "$pid" 2>/dev/null || break; sleep 0.2; done
  kill -KILL -- "-$pid" 2>/dev/null || true
  rm -f "$f"
}

# Process groups of every agent the run's tmux server holds (one per pane).
pane_groups() {
  [ -n "$QV_TMUX_SOCKET" ] || return 0
  tmux -S "$QV_TMUX_SOCKET" list-panes -a -F '#{pane_pid}' 2>/dev/null | while read -r p; do
    ps -o pgid= -p "$p" 2>/dev/null | tr -d ' '
  done | sort -u
}

tmux_server_pid() {
  [ -n "$QV_TMUX_SOCKET" ] || return 0
  tmux -S "$QV_TMUX_SOCKET" display-message -p '#{pid}' 2>/dev/null || true
}

cmd_crash() {
  load
  inst=$run_dir/instance
  [ "$QV_MODE" = real ] || die "crash: needs the real daemon"
  local what=${1:-} pid g
  case $what in
    daemon)
      # SIGKILL, so nothing shuts down cleanly: an engine call in flight dies with it.
      pid=$(cat "$inst/quarkd.pid" 2>/dev/null) || die "crash: the daemon is not running"
      kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
      rm -f "$inst/quarkd.pid"
      echo "crashed the daemon (pid $pid)" ;;
    tmux)
      pid=$(tmux_server_pid)
      [ -n "$pid" ] || die "crash: the run's tmux server is not running"
      kill -KILL "$pid"
      echo "killed the tmux server (pid $pid); its agents lose their terminals" ;;
    host)
      # A reboot as the run sees it: the daemon, the tmux server and every agent
      # are gone at once. The app server and Chromium stay up so the app can be
      # read after the daemon comes back, as a person reopening it would.
      for g in $(pane_groups); do kill -KILL -- "-$g" 2>/dev/null || true; done
      pid=$(tmux_server_pid); [ -z "$pid" ] || kill -KILL "$pid" 2>/dev/null || true
      pid=$(cat "$inst/quarkd.pid" 2>/dev/null || true)
      if [ -n "$pid" ]; then kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true; fi
      rm -f "$inst/quarkd.pid"
      echo "rebooted: the daemon, the tmux server and every agent are gone; start the daemon with: quark-verify restart" ;;
    *) die "crash: usage: crash daemon|tmux|host" ;;
  esac
}

cmd_restart() {
  load
  inst=$run_dir/instance
  [ "$QV_MODE" = real ] || die "restart: needs the real daemon"
  alive quarkd && die "restart: the daemon is still running (pid $(cat "$inst/quarkd.pid"))"
  start_bg quarkd "$inst/quarkd.sh"
  wait_http "$QV_DAEMON/v1/health" 60 "the restarted daemon"
  echo "restarted the daemon (pid $(cat "$inst/quarkd.pid"))"
}

cmd_sleep() {
  load
  inst=$run_dir/instance
  [ "$QV_MODE" = real ] || die "sleep: needs the real daemon"
  local secs=${1:-} groups pids p
  [[ $secs =~ ^[0-9]+$ ]] || die "sleep: usage: sleep <secs>"
  # Stop agents first and the daemon last, and continue in reverse, so no
  # running process sees another one frozen.
  groups=$(pane_groups)
  pids="$(tmux_server_pid) $(cat "$inst/quarkd.pid" 2>/dev/null || true)"
  for p in $groups; do kill -STOP -- "-$p" 2>/dev/null || true; done
  for p in $pids; do kill -STOP -- "-$p" 2>/dev/null || kill -STOP "$p" 2>/dev/null || true; done
  echo "asleep for ${secs}s (daemon, tmux server and $(echo "$groups" | grep -c .) agent groups stopped)"
  sleep "$secs"
  for p in $(echo "$pids" | tr ' ' '\n' | tac); do kill -CONT -- "-$p" 2>/dev/null || kill -CONT "$p" 2>/dev/null || true; done
  for p in $groups; do kill -CONT -- "-$p" 2>/dev/null || true; done
  echo "awake"
}

cmd_cleanup() {
  load
  inst=$run_dir/instance
  stop_pid chromium
  stop_pid serve
  stop_pid quarkd
  if [ -n "$QV_TMUX_SOCKET" ] && [ -S "$QV_TMUX_SOCKET" ]; then
    tmux -S "$QV_TMUX_SOCKET" kill-server 2>/dev/null || true
  fi
  # Keep the daemon log with the evidence; drop the rest of the instance.
  [ -f "$inst/quarkd.log" ] && cp "$inst/quarkd.log" "$QV_EVIDENCE/daemon.log"
  rm -rf "$inst"
  [ "$(cat "$base/current" 2>/dev/null)" = "$QV_RUN" ] && rm -f "$base/current"
  echo "cleaned up run $QV_RUN; evidence kept in $QV_EVIDENCE"
  ls -1 "$QV_EVIDENCE"
}

sub=${1:-}; shift || true
case $sub in
  launch) cmd_launch "$@" ;;
  doctor) cmd_doctor ;;
  env) load; cat "$run_dir/instance/run.env" ;;
  browser) load; (export QV_CDP QV_APP QV_DAEMON_FOR_APP QV_EVIDENCE; node "$here/browser.mjs" "$@") ;;
  api) cmd_api "$@" ;;
  events) cmd_events "$@" ;;
  tmux) cmd_tmux "$@" ;;
  capture) cmd_capture "$@" ;;
  crash) cmd_crash "$@" ;;
  restart) cmd_restart ;;
  sleep) cmd_sleep "$@" ;;
  agents) load; cat "$QV_EVIDENCE/agents.jsonl" 2>/dev/null || true ;;
  journey) [ -x "$here/journey-${1:-}" ] || die "journey: unknown journey ${1:-}; see ../features/README.md"
           j=$1; shift; QV_HELPER="$here/quark-verify" exec "$here/journey-$j" "$@" ;;
  cleanup) cmd_cleanup ;;
  *) sed -n '2,/^set -euo/p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'; [ -z "$sub" ] || exit 2 ;;
esac
