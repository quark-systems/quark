#!/usr/bin/env bash
# fake-agent: a stand-in for a harness CLI (installed as `claude` on the
# daemon's PATH by `quark-verify launch --harness fake`), so journeys can run
# agents without a signed-in account or network. It is not an LLM: it draws a
# prompt, echoes what is typed, and stays alive until its terminal goes away.
#
# Every start appends one JSON line to $QV_AGENT_JOURNAL (when set):
#   {"ts":..., "pid":..., "name":"claude", "cwd":..., "resumed":true|false, "argv":[...]}
# "resumed" is true when the launch asks the harness to continue an earlier
# conversation (--resume or --continue, as Claude Code takes them), which is
# how a journey tells a resumed agent from a fresh one.
set -u

name=$(basename "$0")
resumed=false
for a in "$@"; do
  case $a in --resume | --resume=* | --continue | -c | -r) resumed=true ;; esac
done

json_str() { # escape for a JSON string
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}; s=${s//$'\t'/\\t}
  printf '"%s"' "$s"
}

if [ -n "${QV_AGENT_JOURNAL:-}" ]; then
  # One write per start, so agents starting together never interleave.
  entry=$(printf '{"ts":%s,"pid":%s,"name":%s,"cwd":%s,"resumed":%s,"argv":[' \
    "$(date +%s)" "$$" "$(json_str "$name")" "$(json_str "$PWD")" "$resumed")
  sep=""
  for a in "$@"; do entry+="$sep$(json_str "$a")"; sep=","; done
  printf '%s]}\n' "$entry" >>"$QV_AGENT_JOURNAL"
fi

# Non-interactive calls (version probes, `-p` one-shots) answer and exit.
case "${1:-}" in
  --version | -v) echo "0.0.0 (fake-agent)"; exit 0 ;;
  -p | --print) echo "fake-agent"; exit 0 ;;
esac

echo "fake-agent $name pid $$ ($([ "$resumed" = true ] && echo resumed || echo fresh))"

# Claude Code logs each conversation under
# $CLAUDE_CONFIG_DIR/projects/<cwd with every non-alphanumeric as ->/<id>.jsonl,
# and an engine looks there before asking it to continue one. The fake keeps
# that log too, only when the run gave it a private config directory.
if [ "$name" = claude ] && [ -n "${QV_AGENT_JOURNAL:-}" ] && [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
  log_dir=$CLAUDE_CONFIG_DIR/projects/$(printf '%s' "$PWD" | sed 's/[^A-Za-z0-9]/-/g')
  mkdir -p "$log_dir"
  # shellcheck disable=SC2012 # the logs are named by uuid
  log=$(ls -t "$log_dir"/*.jsonl 2>/dev/null | head -1)
  if [ "$resumed" = false ] || [ -z "$log" ]; then
    log=$log_dir/$(cat /proc/sys/kernel/random/uuid 2>/dev/null || echo "fake-$$-$(date +%s)").jsonl
  fi
  printf '{"type":"system","subtype":"fake-agent","pid":%s,"cwd":%s,"resumed":%s}\n' \
    "$$" "$(json_str "$PWD")" "$resumed" >>"$log"
fi

# The engine may write Claude Code hooks into the agent's directory (the
# coordinator's turn-end hook); the agent keeps that bookkeeping the way
# Claude Code does: UserPromptSubmit when a line arrives, Stop when the turn
# ends. A worker is told its status file in its environment.
hooks=.claude/settings.local.json
status_file=${QUARK_STATUS_FILE:-}

hook() { # UserPromptSubmit | Stop | SessionEnd
  [ -f "$hooks" ] && command -v jq >/dev/null || return 0
  jq -r --arg e "$1" '.hooks[$e][]?.hooks[]?.command // empty' "$hooks" 2>/dev/null |
    while IFS= read -r c; do bash -c "$c" </dev/null >/dev/null 2>&1; done
}

echo "Working..."
hook Stop
# Claude Code's empty composer is a bare `❯` row; the engine reads it before
# typing into the agent (an exit, a steer).
while IFS= read -r -p '❯ ' line; do
  # Text the engine pastes arrives inside bracketed-paste markers.
  line=${line//$'\e[200~'/}; line=${line//$'\e[201~'/}
  # Claude Code's /exit ends the session, as the engine's exit control types it.
  if [ "$line" = /exit ]; then
    hook SessionEnd
    exit 0
  fi
  hook UserPromptSubmit
  echo "fake-agent: got ${line}"
  # A scripted worker turn: `QV-STATUS <line>` appends <line> to the task's
  # status file, as a worker reports (the journeys drive these), with
  # `{pid}` replaced by this process's pid so a journey can tell which
  # process answered. An answer the engine relays (`Answer to [<key>]:
  # <answer>`) is acknowledged the same way, as a worker carrying on would.
  case $line in
    "QV-STATUS "*) [ -n "$status_file" ] && printf '%s\n' "${line#QV-STATUS }" | sed "s/{pid}/$$/g" >>"$status_file" ;;
    "Answer to ["*"]: "*)
      key=${line#Answer to \[}; key=${key%%\]*}
      [ -n "$status_file" ] && printf 'working: answered %s: %s\n' "$key" "${line#*\]: }" >>"$status_file" ;;
  esac
  hook Stop
done
