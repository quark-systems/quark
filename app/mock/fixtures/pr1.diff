+/// than this many events behind are lagged and must resync from the store.
+const CHANNEL_CAPACITY: usize = 4096;
 
 pub struct EventBus {
     store: Arc<Mutex<EventStore>>,
     tx: broadcast::Sender<Arc<Event>>,
 }
 
+/// What a subscriber should do after a receive attempt.
+#[derive(Debug)]
+pub enum Next {
+    /// A live event, in order.
+    Event(Arc<Event>),
+    /// The subscriber lagged; these events were recovered from the store.
+    Resync(Vec<Arc<Event>>),
+    /// The bus has shut down.
+    Closed,
+}
