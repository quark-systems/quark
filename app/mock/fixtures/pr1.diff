+
+    /// Receive the next event for a subscriber whose last delivered event
+    /// was `last_seq`, transparently recovering from lag.
+    pub async fn next(
+        &self,
+        rx: &mut broadcast::Receiver<Arc<Event>>,
+        last_seq: u64,
+    ) -> Next {
+        loop {
+            match rx.recv().await {
+                Ok(ev) if ev.seq <= last_seq => continue,
+                Ok(ev) => return Next::Event(ev),
+                Err(broadcast::error::RecvError::Lagged(n)) => {
+                    warn!(skipped = n, last_seq, "subscriber lagged; resyncing");
+                    return Next::Resync(self.replay(last_seq).await);
+                }
+                Err(broadcast::error::RecvError::Closed) => return Next::Closed,
+            }
+        }
+    }
 }
 
