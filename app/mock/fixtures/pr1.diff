@@ -2,20 +2,48 @@ import { useEffect, useRef } from "react";
 import type { DaemonEvent } from "../api/types";
 
 const DAEMON_WS = "ws://127.0.0.1:7420/v1/events";
+const MAX_BACKOFF_MS = 10_000;
 
+/**
+ * Subscribe to the daemon event stream.
+ *
+ * Reconnects with exponential backoff and resumes from the last seen
+ * `seq`, so a dropped socket never loses or duplicates events.
+ */
 export function useEvents(onEvent: (ev: DaemonEvent) => void) {
   const handler = useRef(onEvent);
   handler.current = onEvent;
 
   useEffect(() => {
-    const ws = new WebSocket(DAEMON_WS);
-    ws.onmessage = (msg) => {
-      const ev = JSON.parse(msg.data) as DaemonEvent;
-      handler.current(ev);
+    let cursor = 0;
+    let backoff = 250;
+    let ws: WebSocket | null = null;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let disposed = false;
+
+    const connect = () => {
+      ws = new WebSocket(`${DAEMON_WS}?cursor=${cursor}`);
+      ws.onopen = () => {
+        backoff = 250;
+      };
+      ws.onmessage = (msg) => {
+        const ev = JSON.parse(msg.data) as DaemonEvent;
+        if (ev.seq <= cursor) return; // duplicate after resync
+        cursor = ev.seq;
+        handler.current(ev);
+      };
+      ws.onclose = () => {
+        if (disposed) return;
+        timer = setTimeout(connect, backoff);
+        backoff = Math.min(backoff * 2, MAX_BACKOFF_MS);
+      };
     };
-    ws.onclose = () => {
-      console.warn("event stream closed");
+
+    connect();
+    return () => {
+      disposed = true;
+      clearTimeout(timer);
+      ws?.close();
     };
-    return () => ws.close();
   }, []);
 }
