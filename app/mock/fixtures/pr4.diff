+export interface Plan {
+  id: "solo" | "team" | "enterprise";
+  name: string;
+  /** Monthly price in USD per seat; null means "talk to us". */
+  price: number | null;
+  workers: number | "unlimited";
+  features: string[];
+  highlighted?: boolean;
+}
+
+export const plans: Plan[] = [
+  {
+    id: "solo",
+    name: "Solo",
+    price: 0,
+    workers: 2,
+    features: ["Local daemon", "Two parallel workers", "Community support"],
+  },
+  {
+    id: "team",
+    name: "Team",
+    price: 24,
+    workers: 8,
+    features: ["Shared decisions inbox", "PR review queue", "Slack relay"],
+    highlighted: true,
+  },
+  {
+    id: "enterprise",
+    name: "Enterprise",
+    price: null,
+    workers: "unlimited",
+    features: ["SSO and audit log", "Self-hosted relay", "Priority support"],
+  },
 ];
+
+export function formatPrice(plan: Plan): string {
+  if (plan.price === null) return "Contact us";
+  if (plan.price === 0) return "Free";
+  return `$${plan.price} / seat / mo`;
+}
