+//! Render Open Graph images for every page that declares a title.
+//!
+//! Usage: `og-image [--out-dir public/og] <page-title>...`
+
 use std::path::PathBuf;
+use std::process::ExitCode;
+
+struct Args {
+    out_dir: PathBuf,
+    titles: Vec<String>,
+}
+
+fn parse_args() -> Result<Args, String> {
+    let mut out_dir = PathBuf::from("public/og");
+    let mut titles = Vec::new();
+    let mut args = std::env::args().skip(1);
+    while let Some(arg) = args.next() {
+        match arg.as_str() {
+            "--out-dir" => {
+                out_dir = args.next().ok_or("--out-dir needs a value")?.into();
+            }
+            _ => titles.push(arg),
+        }
+    }
+    if titles.is_empty() {
+        titles.push("Quark".into());
+    }
+    Ok(Args { out_dir, titles })
+}
+
+/// `"Pricing & Plans"` -> `"pricing-plans"`.
+fn slug(title: &str) -> String {
+    title
+        .split(|c: char| !c.is_ascii_alphanumeric())
+        .filter(|s| !s.is_empty())
+        .map(str::to_ascii_lowercase)
+        .collect::<Vec<_>>()
+        .join("-")
+}
+
+fn main() -> ExitCode {
+    let args = match parse_args() {
+        Ok(a) => a,
+        Err(e) => {
+            eprintln!("og-image: {e}");
+            return ExitCode::from(2);
+        }
+    };
+    std::fs::create_dir_all(&args.out_dir).expect("create output dir");
+    for title in &args.titles {
+        let out = args.out_dir.join(format!("{}.png", slug(title)));
+        if let Err(e) = og_image::render(title, &out) {
+            eprintln!("og-image: {title}: {e}");
+            return ExitCode::FAILURE;
+        }
+        println!("wrote {}", out.display());
+    }
+    ExitCode::SUCCESS
+}
+
+#[cfg(test)]
+mod tests {
+    use super::slug;
 
