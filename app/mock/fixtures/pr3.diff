 use serde::{Deserialize, Serialize};
+use thiserror::Error;
+
+/// One choice offered to the captain, with what happens if it is picked.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct DecisionOption {
+    pub label: String,
+    pub consequence: String,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum DecisionState {
+    Open,
+    Answered,
+}
 
 #[derive(Debug, Clone, Serialize, Deserialize)]
 pub struct Decision {
     pub id: String,
+    pub project_id: String,
+    pub task_id: String,
     pub question: String,
-    pub options: Vec<String>,
-    pub answer: Option<String>,
+    pub context: String,
+    pub options: Vec<DecisionOption>,
+    /// Index into `options` of the option the worker recommends.
+    pub recommended: usize,
+    pub state: DecisionState,
+    /// Index into `options`, set once answered.
+    pub answer: Option<usize>,
+}
+
+#[derive(Debug, Error, PartialEq, Eq)]
+pub enum AnswerError {
+    #[error("decision {0} is already answered")]
+    AlreadyAnswered(String),
+    #[error("option {index} out of range (decision has {len} options)")]
+    OutOfRange { index: usize, len: usize },
 }
 
 impl Decision {
-    pub fn answer(&mut self, choice: &str) {
-        self.answer = Some(choice.to_string());
+    /// Record the captain's answer. Answers are final.
+    pub fn answer(&mut self, index: usize) -> Result<(), AnswerError> {
+        if self.state == DecisionState::Answered {
+            return Err(AnswerError::AlreadyAnswered(self.id.clone()));
+        }
+        if index >= self.options.len() {
+            return Err(AnswerError::OutOfRange {
+                index,
+                len: self.options.len(),
+            });
+        }
+        self.answer = Some(index);
+        self.state = DecisionState::Answered;
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn sample() -> Decision {
+        Decision {
+            id: "d1".into(),
+            project_id: "firstmate".into(),
+            task_id: "t1".into(),
+            question: "Merge now?".into(),
+            context: String::new(),
+            options: vec![
+                DecisionOption { label: "Yes".into(), consequence: "Ships today".into() },
+                DecisionOption { label: "No".into(), consequence: "Waits a day".into() },
+            ],
+            recommended: 0,
+            state: DecisionState::Open,
+            answer: None,
+        }
+    }
+
+    #[test]
+    fn answers_are_final() {
+        let mut d = sample();
+        assert_eq!(d.answer(1), Ok(()));
+        assert_eq!(d.answer(0), Err(AnswerError::AlreadyAnswered("d1".into())));
+    }
+
+    #[test]
+    fn rejects_out_of_range() {
+        let mut d = sample();
+        assert_eq!(d.answer(5), Err(AnswerError::OutOfRange { index: 5, len: 2 }));
     }
 }
