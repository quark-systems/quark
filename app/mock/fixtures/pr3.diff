+export async function answerDecision(id: string, option: number): Promise<Decision> {
+  const res = await fetch(`/v1/decisions/${encodeURIComponent(id)}:answer`, {
     method: "POST",
-    body: JSON.stringify({ choice }),
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ option }),
   });
+  if (!res.ok) {
+    throw new DecisionError(res.status, await res.text());
+  }
+  return (await res.json()) as Decision;
+}
